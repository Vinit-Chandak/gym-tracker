    "audit:start": "node scripts/dev/audit.mjs start",
    "audit:screens": "node scripts/dev/audit-browser.mjs",
    "audit:flows": "node scripts/dev/audit-flows.mjs",
    "audit:workout": "node scripts/dev/audit-workout.mjs",
    "audit:account": "node scripts/dev/audit-account.mjs",
    "audit:programme": "node scripts/dev/audit-programme.mjs",
    "audit:history": "node scripts/dev/audit-history.mjs",
    "audit:bookmarks": "node scripts/dev/audit-bookmarks.mjs",
