# Copy this file to .env.local for local development. Never commit real values.
# SETUP.md explains where each value comes from in the Supabase dashboard.

# --- Supabase (browser-safe) ---------------------------------------------------
# Project Settings → API Keys → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Postgres (server-side only, never sent to the browser) -------------------
# "Connect" → Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL=
# "Connect" → Session pooler (port 5432). Used by migrations and the seed script.
DIRECT_DATABASE_URL=

# --- Email links ---------------------------------------------------------------
# The origin Supabase should send people back to after a confirmation or password
# reset email. Leave empty locally: the request's own host is used instead. Set it
# in production so emails never point at a preview deployment.
NEXT_PUBLIC_SITE_URL=

# --- Optional: full account deletion -------------------------------------------
# Deleting an account always erases every row that account owns. Removing the
# Supabase sign-in record as well needs the service-role key. Leave this empty and
# the app says so plainly instead; the login can then be deleted from the dashboard.
# Server-side only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
