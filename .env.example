# Copy this file to .env.local for local development. Never commit real values.
#
# Phase 0 (app shell) needs no environment variables at all.
# Phase 1 (database + auth) will finalize this list once the Postgres/auth
# provider is confirmed. The names below follow the Supabase setup described in
# DATA_MODEL_AND_ARCHITECTURE.md.

# Supabase project URL and public (anon/publishable) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres connection string. Server-side only: migrations and seeds.
# Never expose this (or a service-role key) to the client bundle.
DATABASE_URL=
