# Copy this file to .env.local for local development. Never commit real values.
# SETUP.md explains where each value comes from in the Supabase dashboard.

# --- Supabase (browser-safe) ---------------------------------------------------
# Project Settings → API Keys → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Postgres (server-side only, never sent to the browser) -------------------
# "Connect" → Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL=
# "Connect" → Session pooler (port 5432). Used by migrations and the seed script.
DIRECT_DATABASE_URL=

# --- Email links ---------------------------------------------------------------
# The origin Supabase should send people back to after a confirmation or password
# reset email. Leave empty locally: the request's own host is used instead. Set it
# in production so emails never point at a preview deployment.
# Whatever this resolves to, followed by /auth/confirm, must also be on the Supabase
# project's Redirect URLs list. Supabase ignores an address that is not, and emails
# the project's Site URL instead — which on a new project is http://localhost:3000.
# SETUP.md step 4.2 covers both settings.
NEXT_PUBLIC_SITE_URL=

# --- Optional: verify sessions without a network request ----------------------
# The project's public signing keys, as published at
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Paste that JSON here, on one line. They are public keys, so this is safe to store. With it set,
# a fresh server instance verifies sessions without fetching the keys first; a key it does not
# know (after a rotation) still falls back to fetching. Server-side only.
SUPABASE_JWKS=

# --- Required for account deletion ---------------------------------------------
# Supabase deletes the sign-in record and cascades to all app data in one operation.
# Without this credential, deletion is unavailable and no data is removed.
# Server-side only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: the AI house coach ---------------------------------------------
# A Claude Code routine on the owner's account plans sessions through /api/coach/service.
# docs/coach-automation.md explains the setup. All three are server-side only.
# The secret the routine presents (at least 16 characters). Also stored as an API credential
# on the routine's cloud environment.
COACH_SERVICE_TOKEN=
# The routine's API trigger, so "Re-plan" on Today can start a run. Copied from the routine's
# API trigger settings at claude.ai/code/routines.
COACH_ROUTINE_FIRE_URL=
COACH_ROUTINE_FIRE_TOKEN=
# Enable only after migrations 0013–0015 and the updated cloud routine are installed.
COACH_WORKFLOW_ENABLED=false
# Independent rollout controls, subordinate to the workflow master switch.
# Intake=false pauses new setups; existing answers and report removal remain accessible.
COACH_INTAKE_ENABLED=true
# Generation=false pauses new programme requests. Existing drafts remain usable.
COACH_GENERATION_ENABLED=true
# Dispatcher=false pauses scheduling new daily/weekly jobs; queued jobs can still finish.
COACH_DISPATCHER_ENABLED=true
# Automatic reviews=false saves every proposed change for athlete review.
COACH_AUTOMATIC_REVIEWS_ENABLED=true
