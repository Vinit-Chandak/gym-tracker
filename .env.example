# Copy this file to .env.local for local development. Never commit real values.
# SETUP.md explains where each value comes from in the Supabase dashboard.

# --- Supabase (browser-safe) ---------------------------------------------------
# Project Settings → API Keys → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Postgres (server-side only, never sent to the browser) -------------------
# "Connect" → Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL=
# "Connect" → Session pooler (port 5432). Used by migrations and the seed script.
DIRECT_DATABASE_URL=

# --- Seeding ------------------------------------------------------------------
# Email of the login user you created in Supabase Auth. `npm run db:seed` creates
# that user's gyms, equipment and the 8-week programme. Leave empty to seed only
# the shared reference data (exercises, equipment types, warm-ups).
SEED_USER_EMAIL=
